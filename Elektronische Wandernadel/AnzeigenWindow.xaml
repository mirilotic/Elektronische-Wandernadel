<Window x:Class="Elektronische_Wandernadel.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektronische_Wandernadel"
        mc:Ignorable="d"
        Title="Erfolgstabelle" Height="466" Width="812"
        ResizeMode="NoResize"
       >
    <Grid>
        <DataGrid x:Name="HWNDataGrid"
                   SelectionMode="Single"
                  SelectionUnit="FullRow"
          AutoGenerateColumns="True"
          AutoGeneratedColumns="HWNDataGrid_AutoGeneratedColumns"
          IsReadOnly="False"
          CanUserAddRows="False" Margin="0,3,0,79"/>
        <Button x:Name="tabelleZurückButton" Content="Zurück" Margin="633,0,0,23" FontSize="16" Click="tabelleZurückButton_Click" HorizontalAlignment="Left" Width="148" Height="39" VerticalAlignment="Bottom"/>
        <Button x:Name="tabelleLöschenButton" Content="Tabelle löschen" Margin="461,0,0,23" FontSize="16" Click="tabelleLöschenButton_Click" HorizontalAlignment="Left" Width="148" Height="39" VerticalAlignment="Bottom"/>
        <Button x:Name="ändernButton" Content="Ändern" Margin="87,0,0,24" FontSize="16" Click="ändernButton_Click" HorizontalAlignment="Left" Width="148" Height="38" VerticalAlignment="Bottom"/>
        <Button x:Name="zeileLöschenButton" Content="Zeile löschen" Margin="280,0,0,24" FontSize="16" Click="zeileLöschenButton_Click" HorizontalAlignment="Left" Width="148" Height="38" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
