<Window x:Class="Elektronische_Wandernadel.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektronische_Wandernadel"
        mc:Ignorable="d"
        Title="Statistik" Height="440" Width="373"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="146*"/>
            <ColumnDefinition Width="227*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="w4zurückButton" Content="Zurück" Margin="145,0,0,24" FontSize="16" HorizontalAlignment="Left" Width="104" Height="34" VerticalAlignment="Bottom" Click="w4zurückButton_Click" Grid.ColumnSpan="2"/>
        <Label Content="Erreichte Stempel:" Margin="10,148,0,0" FontSize="16" HorizontalAlignment="Left" Width="174" Height="34" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Label Content="Zu holende Stempel:" Margin="10,187,0,0" FontSize="16" HorizontalAlignment="Left" Width="174" Height="41" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Label Content="Aktuelles Abzeichen:" Margin="10,228,0,0" FontSize="16" HorizontalAlignment="Left" Width="174" Height="41" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Label Content="Stempel bis zum &#xA;nächsten Abzeichen:" Margin="11,274,0,0" FontSize="16" HorizontalAlignment="Left" Width="157" Height="69" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Image HorizontalAlignment="Left" Height="107" Margin="56,27,0,0" VerticalAlignment="Top" Width="262" Source="/harz.jpg" Grid.ColumnSpan="2"/>
        <Label x:Name="erreichtLabel" Margin="22,148,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108" Grid.Column="1"/>
        <Label x:Name="zuholenLabel" Content="" Margin="22,187,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108" Grid.Column="1"/>
        <Label x:Name="abzeichenLabel" Content="" Margin="0,228,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" Width="181" Grid.Column="1"/>
        <Label x:Name="zumnächstenLabel" Content="" Margin="22,295,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108" Grid.Column="1"/>

    </Grid>
</Window>
