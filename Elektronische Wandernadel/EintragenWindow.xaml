<Window x:Class="Elektronische_Wandernadel.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektronische_Wandernadel"
        mc:Ignorable="d"
        Title="Bitte eintragen" Height="505" Width="577"
        ResizeMode="NoResize">
    <Grid>
        <Label Content="Bitte eintragen..." Margin="48,29,0,0" FontSize="16" Width="153" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="HWN-Nr.:" Margin="63,91,0,0" FontSize="16" Width="95" HorizontalAlignment="Left" Height="31" VerticalAlignment="Top"/>
        <TextBox x:Name="hwnBox" HorizontalAlignment="Left" Height="35" Margin="236,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="262" FontSize="16"/>
        <TextBox x:Name="nameBox" HorizontalAlignment="Left" Height="35" Margin="236,165,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="262" FontSize="16"/>
        <TextBox x:Name="stempelBox" HorizontalAlignment="Left" Height="35" Margin="236,313,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="262" FontSize="16"/>
        <Label Content="Name:" Margin="63,165,0,0" FontSize="16" Width="95" HorizontalAlignment="Left" Height="31" VerticalAlignment="Top"/>
        <Label Content="Erreicht am:" Margin="63,239,0,0" FontSize="16" Width="95" HorizontalAlignment="Left" Height="31" VerticalAlignment="Top"/>
        <Label Content="Stempel-Nr." Margin="63,313,0,0" FontSize="16" Width="95" RenderTransformOrigin="0.5,0.5" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <DatePicker x:Name="datumBox" HorizontalAlignment="Left" Height="35" Margin="236,239,0,0" VerticalAlignment="Top" Width="262" FontSize="16"/>
        <Button x:Name="fertigButton" Content="Fertig" HorizontalAlignment="Left" Height="40" Margin="220,403,0,0" VerticalAlignment="Top" Width="147" FontSize="16" Click="fertigButton_Click"/>
        <Button x:Name="eintragenzurückButton" Content="Zurück" HorizontalAlignment="Left" Height="40" Margin="395,403,0,0" VerticalAlignment="Top" Width="147" FontSize="16" Click="eintragenzurückButton_Click"/>
        <Button x:Name="w1fragezeichenButton" Content="?" HorizontalAlignment="Left" Height="40" Margin="48,403,0,0" VerticalAlignment="Top" Width="45" RenderTransformOrigin="1.488,0.682" FontSize="16" Click="w1fragezeichenButton_Click"/>

    </Grid>
</Window>
