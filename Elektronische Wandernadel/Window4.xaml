        <Label x:Name="erreichtLabel" Margin="168,148,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108"/>
        <Label x:Name="zuholenLabel" Content="" Margin="168,187,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108"/>
        <Label x:Name="abzeichenLabel" Content="" Margin="168,228,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="181"/>
        <Label x:Name="zumnächstenLabel" Content="" Margin="168,295,0,0" FontSize="16" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="108"/>

    </Grid>
</Window>
