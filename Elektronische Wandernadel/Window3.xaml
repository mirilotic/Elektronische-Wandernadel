<Window x:Class="Elektronische_Wandernadel.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektronische_Wandernadel"
        mc:Ignorable="d"
        Title="Dein Zimmer" Height="562" Width="800"
        ResizeMode="NoResize">
    <Grid>
        <Button x:Name="zimmerzurueckButton" Content="Zurück" Margin="0,0,10,10" Click="zimmerzurueckButton_Click" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="123" FontSize="16"/>
        <Image x:Name="zimmerBild" Margin="5,5,5,55" Source="{Binding Bildpfad}"/>
        <Button x:Name="fragezeichenButton" Content="?" HorizontalAlignment="Left" Margin="37,0,0,10" Width="41" FontSize="16" Click="fragezeichenButton_Click" Height="34" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
