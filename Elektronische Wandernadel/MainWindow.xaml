<Window x:Class="Elektronische_Wandernadel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektronische_Wandernadel"
        mc:Ignorable="d"
        Title="Elektronische Wandernadel" Height="446" Width="715"
        ResizeMode="NoResize">
    <Grid>
        <Label x:Name="willkommenLabel" Content="Willkommen bei der elektronischen Wandernadel!&#xA;Hier kannst du deine Stempelerfolge eintragen und einsehen.&#xA;Was möchtest du tun?" HorizontalAlignment="Center" Margin="0,0,0,120" Width="498" FontSize="16" Height="78" VerticalAlignment="Bottom"/>
        <Image HorizontalAlignment="Left" Margin="191,0,0,224" Width="360" Source="/wandernadel.jpg" Height="166" VerticalAlignment="Bottom"/>
        <Button x:Name="eintragenButton" Content="Eintragen" Margin="0,0,543,50" FontSize="16" Click="eintragenButton_Click" HorizontalAlignment="Right" Width="126" Height="45" VerticalAlignment="Bottom"/>
        <Button x:Name="tabelleButton" Content="Tabelle ansehen" Margin="379,0,0,50" FontSize="16" Click="tabelleButton_Click" Height="45" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="126"/>
        <Button x:Name="statistikButton" Content="Statistik ansehen" Margin="543,0,0,50" FontSize="16" Click="statistikButton_Click" Height="45" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="126"/>
        <Button x:Name="zimmerButton" Content="Zimmer ansehen" Margin="212,0,0,50" FontSize="16" HorizontalAlignment="Left" Width="126" Height="45" VerticalAlignment="Bottom" Click="zimmerButton_Click" RenderTransformOrigin="0.489,0.546"/>

    </Grid>
</Window>
