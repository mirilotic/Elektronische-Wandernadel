<Window x:Class="Elektronische_Wandernadel.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektronische_Wandernadel"
        mc:Ignorable="d"
        Title="Erfolgstabelle" Height="466" Width="812"
        ResizeMode="NoResize">
    <Grid>
        <DataGrid x:Name="HWNDataGrid"
          AutoGenerateColumns="True"
          AutoGeneratedColumns="HWNDataGrid_AutoGeneratedColumns"
          IsReadOnly="False"
          CanUserAddRows="False" Margin="0,3,0,79"/>
        <Button x:Name="tabellezurückButton" Content="Zurück" Margin="633,0,0,23" FontSize="16" Click="tabellezurückButton_Click" HorizontalAlignment="Left" Width="148" Height="39" VerticalAlignment="Bottom"/>
        <Button x:Name="löschenButton" Content="Löschen" Margin="461,0,0,23" FontSize="16" Click="löschenButton_Click" HorizontalAlignment="Left" Width="148" Height="39" VerticalAlignment="Bottom"/>
        <Button x:Name="ändernButton" Content="Ändern" Margin="284,0,0,23" FontSize="16" Click="ändernButton_Click" HorizontalAlignment="Left" Width="148" Height="38" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
